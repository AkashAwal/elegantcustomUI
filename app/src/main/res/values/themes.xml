<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base platform theme wrapping the Compose content. Compose owns all
         actual widget styling (see ui/theme/Theme.kt); this only controls
         window-level attributes Compose can't set itself, like the
         pre-Compose-draw background color (avoids a white flash on TVs
         that are otherwise fully dark-themed). -->
    <style name="Theme.TvLauncher" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/tv_background_black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:navigationBarColor">@color/tv_background_black</item>
        <item name="android:statusBarColor">@color/tv_background_black</item>
    </style>
</resources>
